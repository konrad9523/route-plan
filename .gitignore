# ===== Python 自动生成的缓存，不该进版本库 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# pip 因权限问题遗留在工作目录的临时目录（正常不该出现，出现了也别提交）
pip-build-tracker-*/
pip-download-*/
pip-unpack-*/

# uv 的缓存与工具目录（重建仓库时安装 filter-repo 会用到，见重建清单 §3.5）
_uvcache/
_uvtools/
_uvbin/
_frtest/
_frtest_repo/
_tmp/

# ===== 虚拟环境 =====
.venv/
venv/

# ===== PyCharm / VS Code =====
.idea/
.vscode/

# ===== OSM/地理编码下载缓存（可重新下载，体积大，不进版本库）=====
cache/

# ===== 临时实验文件（学习笔记里让你动手写的，不必提交）=====
tests/try_it.py
_tmp_*.py
_probe_*.py
# Agent/手工调试用的一次性脚本；正式工具放 tools/ 并提交
_check*.py
_tree.py
_lint.py

# ===== 系统垃圾文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 第三方参考代码（克隆下来的开源项目，不属于我们自己的代码）=====
# 这些是学习参考资料，体积大、更新频繁，不进我们的版本库
references/
# Keep the project's own reference catalog while ignoring downloaded repositories.
!docs/references/
!docs/references/参考项目清单.md
第三方代码/
probe_*.py

# ===== 已迁移数据的旧位置（防止用 git add -A 时误加）=====
# learning_osmnx_networkx/route_demo.py 运行后会重新生成 output/graph.graphml，
# 它与 data/campus_552.graphml 字节完全相同（sha256 ebbbec4fccd138b9），
# 属于同一份路网的重复副本。正式路网只有 data/ 下那一份。
# 注意：这些脚本本身在版本库里，只有生成物被忽略。
learning_osmnx_networkx/output/*.graphml

# OSRM native build output (kept at repository root to stay below Windows path limits)
.osrm-build-vs2022/
.valhalla-build-vs2022/

# A3 local temporary workbench: received files, datasets and experiment artifacts stay untracked
/A3_临时工作区/

# Each collaborator's local-only drafts; shared work belongs in tracked project folders
/个人工作区/
